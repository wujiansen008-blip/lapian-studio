{
  "name": "lapian-studio",
  "version": "0.4.0",
  "private": true,
  "description": "短视频爆款拉片工作台",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "electron . --dev",
    "build": "vite build",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "http-proxy-agent": "^7.0.2",
    "opencc-js": "^1.4.2",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "studio.lapian.app",
    "productName": "拉片工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!/dist/win-unpacked/**",
      "!/dist/*.exe",
      "!/dist/*.blockmap",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "拉片工作台"
    }
  }
}